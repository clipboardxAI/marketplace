{
  "name": "Extract Here",
  "icon": "doc.zipper",
  "author": "NueZip",
  "version": "1.0.0",
  "description": "Extract the selected archive into the current folder using NueZip.",
  "tags": [
    "extract",
    "unzip",
    "archive"
  ],
  "prompt": "",
